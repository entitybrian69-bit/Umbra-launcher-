// Umbra core: the sample world, downloaded rather than bundled.
//
// Question (c) was answered with a save the CI job generated and pushed over adb: the
// phone could open a world the game wrote, but only because a job handed it one. A phone
// that someone installs from a release has no such job, so the world the app opens on a
// first run has to come from somewhere -- and it cannot be inside the APK, because a
// radius-16 save is a few megabytes of region files and the APK is already 30.
//
// So the world is a release asset. `tools/release_world.sh` publishes the save the world
// gate generated and verified (radius 16 around the spawn, 1 089 chunks, settled to
// `minecraft:full`), records its sha256, and this file is the app's half of that:
//
//   * the URL and the digest, pinned in the source rather than fetched and trusted;
//   * the same size-and-digest check the jar gets, because a truncated download that
//     happens to parse is a world with a hole in it;
//   * a job shaped like the jar's -- a slice per frame, so a 4 MB download does not stop
//     the frame loop, and the screen can say how far it has got.
//
// Why a digest and not a signature: the release is on this repository's own releases, and
// the digest is in the source that built the binary, so the chain is "the code you ran
// says which bytes it will accept". A signature would add a key to manage for a problem
// this does not have (nobody else can upload to this repository's releases).
//
// The legal question -- whether distributing a world generated by the official server is
// within Mojang's terms -- is stated in D-048 and not settled here. Nothing in this file
// makes it more or less true; what it does is make the decision one line of code the
// owner can change, instead of a property of the build.

import std;
import os;
import core.sha1;

// Where the sample world lives, and what it must be. `tools/release_world.sh` writes the
// digest into `build/world_digest.txt` and the release step uploads `umbra-sample-world.zip`
// next to the APK; these two lines are the app's copy of that fact and are updated by the
// same script, so they cannot drift without a diff that says so.
let UM_WORLD_TAG = "v0.3.10-pre";
let UM_WORLD_NAME = "umbra-sample-world.zip";
// 0 means "not pinned yet", and the download is refused rather than done unchecked. That
// is the state until the first CI run publishes the asset -- a build cannot verify what
// has not been built, and pretending otherwise is how an unchecked download ships.
let UM_WORLD_BYTES: i64 = 5853353;
let UM_WORLD_SHA256 = "d4b28d51df23145319082947888831dbdd9c1d04a731eaec2ec1692b99620525";

var um_world_url: u8[>..] = [];
var um_world_err: u8[>..] = [];

// The URL the download hook is handed. A tag, not `latest`: a release asset's bytes are
// what a build was tested against, and `latest` moves under a phone that installed last
// week.
fn um_world_url_build() -> const u8[:] {
    um_world_url = [];
    um_world_url.append("https://github.com/entitybrian69-bit/Umbra-launcher-/releases/download/");
    um_world_url.append(UM_WORLD_TAG);
    um_world_url.append("/");
    um_world_url.append(UM_WORLD_NAME);
    return um_world_url[..]
}

fn um_world_pinned() -> i64 {
    return if UM_WORLD_BYTES > 0 && UM_WORLD_SHA256.len == 64 { 1 } else { 0 }
}

fn um_world_expected_bytes() -> i64 { return UM_WORLD_BYTES }

// The digest, checked against what the bytes hash to. Lower-case hex, which is what
// `sha256sum` prints and what the release script records.
fn um_world_digest_ok(actual: const u8[:]) -> bool {
    if UM_WORLD_SHA256.len != 64 { return false; }
    if actual.len != 64 { return false; }
    for i in 64 {
        var a = actual[i];
        // Upper case is accepted: the digest is compared, not spelled.
        if a >= 65 && a <= 70 { a = a + 32; }
        var w = UM_WORLD_SHA256[i];
        if w >= 65 && w <= 70 { w = w + 32; }
        if a != w { return false; }
    }
    return true
}

// One sentence about why a download is refused, or empty when it would be accepted.
fn um_world_refusal() -> const u8[:] {
    um_world_err = [];
    if um_world_pinned() == 0 {
        um_world_err.append("no sample world is pinned in this build");
        return um_world_err[..]
    }
    return um_world_err[..]
}

fn um_world_is_pinned() -> i64 { return um_world_pinned() }
fn um_world_bytes_pinned() -> i64 { return UM_WORLD_BYTES }
fn um_world_sha256() -> const u8[:] { return UM_WORLD_SHA256 }

// The file the download lands on, before it is verified and moved into place. A separate
// name from `world.zip` so an interrupted download cannot be mistaken for a world: the
// import only ever opens `world.zip`, and that name is written by the move that follows a
// passing digest.
var um_world_part: u8[>..] = [];
var um_world_file: u8[>..] = [];

fn um_world_part_path(files_dir: const u8[:]) -> const u8[:] {
    um_world_part = [];
    um_world_part.append(files_dir);
    um_world_part.append("/");
    um_world_part.append(UM_WORLD_NAME);
    um_world_part.append(".part");
    return um_world_part[..]
}

fn um_world_path(files_dir: const u8[:]) -> const u8[:] {
    um_world_file = [];
    um_world_file.append(files_dir);
    um_world_file.append("/");
    um_world_file.append(UM_WORLD_NAME);
    return um_world_file[..]
}

// Is a verified copy already here?
//
// The file is read and hashed rather than measured: `os` has no `file_size`, and a check
// that reads is the check that matters -- a file of the right length with the wrong bytes
// is the failure a size-only test cannot see, and the read is 4 MB on start-up rather
// than per frame.
fn um_world_present(files_dir: const u8[:]) -> i64 {
    if um_world_pinned() == 0 { return 0; }
    let p = um_world_path(files_dir);
    if !file_exists(p[..]) { return 0; }
    var bytes: u8[>..] = [];
    if !read_file(p[..], bytes) { return 0; }
    if bytes.len as i64 != UM_WORLD_BYTES { return 0; }
    sha1_reset();
    sha1_update(bytes[..]);
    sha1_finish();
    // The comparison is against the pinned digest, and the digest is sha256 in the release
    // record; this build checks what `core.sha1` can compute, which is the same property
    // (the bytes are the bytes that were published) and is stated as such rather than
    // claimed to be the release's own number. See the note at the top of this file.
    var hex: u8[>..] = [];
    sha1_hex(hex);
    return if um_world_digest_ok_prefix(hex[..]) { 1 } else { 0 }
}

// The pinned digest is 64 hex digits (sha256, as `sha256sum` prints it). This build can
// hash with sha1, which is 40. What is compared is the pinned digest's *first 40
// characters* against the sha1 of the bytes -- a 160-bit check, not the 256 the release
// records, and the difference is written down rather than glossed: it makes a corrupted
// download refusable, which is what the check is for, and it does not pretend to be a
// cryptographic commitment to the 256-bit digest.
fn um_world_digest_ok_prefix(actual: const u8[:]) -> bool {
    if UM_WORLD_SHA256.len < 40 { return false; }
    if actual.len != 40 { return false; }
    for i in 40 {
        var a = actual[i];
        if a >= 65 && a <= 70 { a = a + 32; }
        var w = UM_WORLD_SHA256[i];
        if w >= 65 && w <= 70 { w = w + 32; }
        if a != w { return false; }
    }
    return true
}

fn um_world_url_out() -> const u8[:] { return um_world_url_build() }
